# Application Configuration
APP_NAME=Hana-Eunhaeng
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hana_eunhaeng
DB_USER=root
DB_PASS=password
DB_PREFIX=he_

# Security
APP_KEY=your-secret-app-key-generate-this
ENCRYPTION_KEY=your-encryption-key-32-chars-min
JWT_SECRET=your-jwt-secret-key

# Email Configuration
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password
MAIL_FROM_ADDRESS=noreply@hana-eunhaeng.com
MAIL_FROM_NAME="Hana-Eunhaeng Banking"

# Session
SESSION_LIFETIME=1440
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax

# Security Headers
ENABLE_CORS=false
CORS_ORIGINS=localhost
ENABLE_RATE_LIMITING=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_MINUTES=15

# 2FA
TWO_FACTOR_ENABLED=true
OTP_DIGITS=6
OTP_WINDOW=30

# Logging
LOG_LEVEL=info
LOG_PATH=/var/log/hana-eunhaeng/

# Payment Gateway (Optional)
STRIPE_KEY=pk_test_xxxx
STRIPE_SECRET=sk_test_xxxx

# AWS S3 (Optional, for document storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=hana-eunhaeng-documents
