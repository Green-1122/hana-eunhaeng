APP_NAME=Hana-Eunhaeng
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hana_eunhaeng
DB_USER=root
DB_PASS=

# Session
SESSION_SECURE=false
SESSION_SAME_SITE=Lax
SESSION_LIFETIME=1440

# Security
CSRF_ENABLED=true
BCRYPT_ROUNDS=12

# Logging
LOG_PATH=storage/logs/

# Mail (Optional: PHPMailer)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=Hana-Eunhaeng
MAIL_FROM_ADDRESS=noreply@hana-eunhaeng.local

# Redis (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Stripe/Payment (Optional)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# Crypto APIs (Optional)
CRYPTO_API_KEY=